import discord
import os
import random
from discord.ext import commands

permisos = discord.Intents.default()
permisos.message_content = True

bot = commands.Bot(command_prefix="!", intents=permisos)

@bot.event
async def on_ready():
    print(f"el bot esta en linea {bot.user}")

@bot.command()
async def hola(ctx):
    await ctx.send(f"¿Hola bienvenido, en que te puedo ayudar hoy {ctx.author.name} ?")

@bot.command()
async def ayuda(ctx):
    await ctx.send("Los comandos que existen son: !hola, !Hablame_de_la_contaminacion, !ayuda")

@bot.command()
async def Hablame_de_la_contaminacion(ctx):
    await ctx.send("Mira los 3 paise más contamnados del la Tierra 🥇 Pakistán: 67,3 µg/m³ de partículas finas (PM2.5)🥈 Bangladés: 66,1 µg/m³🥉 Tayikistán: 57,3 µg/m³")

bot.run ("")
